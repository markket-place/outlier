---
import { getCollection } from "astro:content";
import { footer } from "../../../data/navigation.json";
const stores = await getCollection("stores");
const store = stores?.[0]?.data;
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="wordmark" href="/">
        {store.title}<span>.</span>
      </a>
      <p>
        {store.seo.metaDescription}
        <br />
      </p>
    </div>

    <div class="footer-links">
      <div>
        <p class="footer-label">EXPLORE</p>
        {footer.links.map((link) => <a href={link.link}>{link.text}</a>)}
      </div>

      <div>
        <p class="footer-label">GET IN TOUCH</p>
        <a href=`mailto:${store.slug}@markket.place`>
          Email us ({store.slug}@markket.place)
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <span>&copy; {new Date().getFullYear()} {footer.copyright}</span>
    <span>
      Curated with intention. Powered by <a href="https://markket.place">
        Markkët
      </a>.
    </span>
  </div>
</footer>

<style>
  .site-footer {
    background: #303328;
    color: #f8f7f3;
    padding: 75px max(7vw, 24px) 25px;
  }

  .footer-main {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 60px;
    padding-bottom: 65px;
  }

  .footer-brand {
    max-width: 360px;
  }

  .wordmark {
    display: inline-block;
    color: #f8f7f3;
    font-family: Georgia, serif;
    font-size: 48px;
    letter-spacing: -0.07em;
    text-decoration: none;
  }

  .wordmark span {
    color: #b7bb8e;
  }

  .footer-brand p {
    color: #c3c3b7;
    font-size: 13px;
    line-height: 1.9;
    margin-top: 20px;
  }

  .footer-links {
    display: flex;
    gap: clamp(45px, 9vw, 130px);
  }

  .footer-links > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .footer-label {
    margin: 0 0 8px;
    color: #b7bb8e;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .footer-links a {
    color: #e0dfd5;
    font-size: 12px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover,
  .footer-bottom a:hover {
    color: #b7bb8e;
  }

  .footer-bottom {
    max-width: 1300px;
    margin: 0 auto;
    padding-top: 22px;
    border-top: 1px solid #505145;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #a8a89b;
    font-size: 10px;
  }

  .footer-bottom a {
    color: #d6d6c8;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .site-footer {
      padding-top: 55px;
    }

    .footer-main {
      flex-direction: column;
      gap: 45px;
    }

    .footer-links {
      justify-content: flex-start;
      gap: 55px;
    }

    .footer-bottom {
      flex-direction: column;
      line-height: 1.7;
    }
  }
</style>
